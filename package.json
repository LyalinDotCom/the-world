{
  "name": "the-world-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Game-native local LLM runtime packages plus The World Electron demo.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspace the-world",
    "start": "npm start --workspace the-world",
    "benchmark:gemma": "node scripts/benchmark-gemma-runtime.mjs",
    "install:litert-lm": "python3 -m venv .venv/litert-lm && .venv/litert-lm/bin/python -m pip install --upgrade pip && .venv/litert-lm/bin/python -m pip install litert-lm==0.11.0",
    "import:litert-gemma4": ".venv/litert-lm/bin/litert-lm import --from-huggingface-repo litert-community/gemma-4-E4B-it-litert-lm gemma-4-E4B-it.litertlm gemma4-e4b-litert",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "concurrently": "^9.2.1",
    "electron": "^42.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vitest": "^4.0.14",
    "wait-on": "^9.0.1"
  },
  "dependencies": {
    "zod": "^4.1.13"
  }
}
